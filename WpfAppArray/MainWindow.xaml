<Window x:Class="SystemProgramming4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Random Number Processor" Height="450" Width="700">
    <Grid>
        <!-- Labels and Input Fields -->
        <Label Content="Number of Elements:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,20,0,0"/>
        <TextBox Name="ElementCountTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="140,20,0,0" Width="100"/>

        <Button Content="Generate Numbers" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,60,0,0" Width="150" Click="GenerateNumbers_Click"/>
        <Button Content="Calculate Stats" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="180,60,0,0" Width="150" Click="CalculateStats_Click"/>
        <Button Content="Write to File" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="340,60,0,0" Width="150" Click="WriteToFile_Click"/>

        <!-- Results Display -->
        <TextBox Name="ResultsTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,120,0,0" Width="650" Height="280" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Window>