<Window x:Class="ThreadedRangeProcessor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Threaded Range Processor" Height="400" Width="600">
    <Grid>
        <Label Content="Start of Range:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" />
        <TextBox Name="StartRangeTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="125,10,5,0" Width="100" />

        <Label Content="End of Range:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,50,0,0" />
        <TextBox Name="EndRangeTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="125,50,5,0" Width="100" />

        <Label Content="Number of Threads:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,90,5,0" />
        <TextBox Name="ThreadCountTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="125,90,0,0" Width="100" />

        <Button Content="Start Processing" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,130,0,0" Width="150" Click="StartProcessing_Click" />

        <TextBox Name="ResultsTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,170,0,0" Width="560" Height="180" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
    </Grid>
</Window>